MY_GRADLE_LOCAL = /opt/gradle/gradle-9.4.1/bin/gradle
MANIFEST        = app/src/main/AndroidManifest.xml
MAIN            = xmlstarlet select -T -t -v "//application/activity/@android:name" -n $(MANIFEST)

## ---------------------------------------------------------------------------
## NativeApp — build / deploy helpers
## ---------------------------------------------------------------------------
MY_GRADLE_LOCAL     := /opt/gradle/gradle-9.4.1/bin/gradle
ADB_SELECTED_DEVICE := RX8N9045ELX
#ADB_SELECTED_DEVICE := 7535c5b5
GRADLEW             := ./gradlew
PKG                 := com.example.myapplication
ACTIVITY            := $(shell $(MAIN))
APK                 := app/build/outputs/apk/debug/app-debug.apk
include mk/tools.mk

log = @printf "\033[36m[make]\033[0m %s\n" $1

.DEFAULT_GOAL := help

.PHONY: help build install run uninstall log-app clean

help: _help ## Mostra este help

include mk/keycode.mk
include mk/onoff.mk
include mk/asciinema.mk
include mk/scrcpy.mk
include mk/screen.mk
include mk/android_inter.mk
include mk/third_party.mk

# -----------------------------------------------------------------------------
# DEVICE -- informações e acesso básico
# -----------------------------------------------------------------------------

info: ## mostra informações gerais do dispositivo
	$(call log,$@)
	@echo "=== Android ==="
	@$(ADB) shell getprop ro.build.version.release

	@echo "=== Device ==="
	@$(ADB) shell getprop ro.product.model

	@echo "=== Serial ==="
	@$(ADB) get-serialno

	@echo "=== Battery ==="
	@$(ADB) shell dumpsys battery | grep -E 'level|status|temperature'

	@echo "=== Uptime ==="
	@$(ADB) shell uptime

	@echo "=== IP ==="
	@$(ADB) shell ip addr show wlan0 | grep 'inet '

	@echo "=== CPU ==="
	@$(ADB) shell cat /proc/cpuinfo | grep -E 'Hardware|processor' | tail -2
	@$(ADB) shell cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null | awk '{printf "Freq: %d MHz\n", $$1/1000}'

	@echo "=== RAM ==="
	@$(ADB) shell cat /proc/meminfo | grep -E 'MemTotal|MemFree|MemAvailable'

	@echo "=== Screen ==="
	@$(ADB) shell wm size
	@$(ADB) shell wm density

	@echo "=== Build ==="
	@$(ADB) shell getprop ro.build.id
	@$(ADB) shell getprop ro.product.brand
	@$(ADB) shell getprop ro.product.device

	@echo "=== Processes ==="
	@$(ADB) shell ps | wc -l

	@echo "=== Storage ==="
	@$(ADB) shell '\
		echo "Internal : $$(df -h /data | tail -1 | awk '\''{print $$2 " total, " $$3 " used, " $$4 " free"}'\'')"; \
		echo "Linux    : $$(df -h /data/local/mnt | tail -1 | awk '\''{print $$2 " total, " $$3 " used, " $$4 " free"}'\'')"; \
		echo "SD Card  : $$(df -h /storage/6166-6564 | tail -1 | awk '\''{print $$2 " total, " $$3 " used, " $$4 " free"}'\'')"; \
		echo "Emulated : $$(df -h /storage/emulated/0 | tail -1 | awk '\''{print $$2 " total, " $$3 " used, " $$4 " free"}'\'')"; \
	'

version:
	$(call log,$@)
	@$(ADB_EXEC_OUT) cat /proc/version

devices: ## lista dispositivos conectados via ADB
	$(call log,$@)
	$(ADB) devices

shell: ## abre shell ADB
	$(call log,$@)
	$(ADB_SHELL)

init:
	$(call log,$@)
	$(MY_GRADLE_LOCAL) wrapper

deploy: images init build install run

images:
	./generate-images.sh

build: ## compila o APK (debug)
	$(call log,$@)
	$(GRADLEW) assembleDebug

rebuild:## compila o apk (debug)
	$(call log,$@)
	rm -rf app/.cxx
	$(GRADLEW) clean
	$(GRADLEW) assembleDebug --info

buildlog:## compila o apk ferando log
	$(call log,$@)
	$(GRADLEW) :app:compileDebugKotlin --stacktrace --console=plain > kotlin.log 2>&1

install: build ## instala no dispositivo conectado
	$(call log,$@)
	$(GRADLEW) installDebug
#	$(ADB) install -r $(APK)

run: ## instala e lança a Activity
	$(call log,$@)
	$(ADB) shell am start -n $(PKG)/$(ACTIVITY)

uninstall: ## desinstala do dispositivo
	$(call log,$@)
	$(ADB) uninstall $(PKG)

stop:## stop
	$(call log,$@)
	$(AM) force-stop  $(PKG)

restart: ## Forçar o restart da Activity (fecha e abre novamente em um único comando)
	$(call log,$@)
	$(START) -S -n $(PKG)/$(ACTIVITY)

dry: ## Limpar todos os dados do app (fecha o app e limpa cache/storage
	$(call log,$@)
	$(PM) clear $(PKG)

log-app: ## logcat filtrado para a app
	$(call log,$@)
	$(ADB) logcat -c
	$(ADB) logcat -s -s YogaUI-MainActivity:V YogaUI-FormulaView:V YogaUI-YogaLayout:V YogaUI-LayoutEngine:V yogaui:V
#	$(ADB) logcat -s NativeApp:V AndroidRuntime:E
clean: ## limpa artefatos de build
	$(call log,$@)
	$(GRADLEW) clean

_help:
	$(call log,$@)
	@grep -hE '^[a-zA-Z0-9_-]+:.*?##' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-15s\033[0m %s\n", $$1, $$2}'

