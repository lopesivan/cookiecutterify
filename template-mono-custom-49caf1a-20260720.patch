diff --git a/Makefile b/Makefile
new file mode 100644
index 0000000..02554af
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,34 @@
+CSPROJ  = main.csproj
+RELEASE = bin/Release/main.exe
+DEBUG   = bin/Debug/main.exe
+
+MONO    = /usr/bin/mono
+MSBUILD = /usr/bin/msbuild
+
+all: debug
+clean: clean-debug
+run: run-debug
+
+run-release:
+	$(MONO) $(RELEASE)
+
+release:
+	$(MSBUILD) /p:Configuration=Release $(CSPROJ)
+
+rebuild-release:
+	$(MSBUILD) $(CSPROJ) -t:Rebuild -p:Configuration=Release
+
+clean-release:
+	$(MSBUILD) $(CSPROJ) -t:Clean -p:Configuration=Release
+
+run-debug:
+	$(MONO) $(DEBUG)
+
+debug:
+	$(MSBUILD) $(CSPROJ)
+
+rebuild-debug:
+	$(MSBUILD) $(CSPROJ) -t:Rebuild -p:Configuration=Debug
+
+clean-debug:
+	$(MSBUILD) $(CSPROJ) -t:Clean -p:Configuration=Debug
